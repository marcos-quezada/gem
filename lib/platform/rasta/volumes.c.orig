/*
 * Enumerates mounted volumes for the GEM desktop from the mount table,
 * exposing only real filesystems with capitalized labels.
 *
 * On Linux this reads /proc/mounts via mntent.h. FreeBSD has neither;
 * getfsstat(2) returns the whole mount table in one call instead of a
 * streaming iterator, so the FreeBSD path snapshots it once per
 * gem_os_volume_iter_open() call and walks the snapshot, matching the
 * same "one absolute path per read" contract callers already expect.
 *
 * MIT License (see: LICENSE)
 * Copyright (C) 2026 tomaz stih
 */

#define _GNU_SOURCE
#include "platform/os.h"

#include <ctype.h>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#if defined(__FreeBSD__)
#include <sys/param.h>
#include <sys/mount.h>
#else
#include <mntent.h>
#endif

#if defined(__FreeBSD__)

/*
 * FreeBSD pseudo-filesystem type names to skip, mirroring the intent of
 * the Linux ignore-list above (proc/sysfs/cgroup/overlay/etc.): virtual
 * or bookkeeping mounts a user would never pick as a "volume". Real,
 * user-mountable filesystems (zfs, ufs, msdosfs, cd9660, exfat, ...) are
 * deliberately NOT in this list.
 *
 * This list is a best-effort port of Linux's list's *intent*, not a
 * verified-exhaustive FreeBSD survey -- worth revisiting against real
 * `getfsstat`/`mount` output on the target machine once this is
 * actually exercised there.
 */
static const char *const gem_os_ignored_fstypes[] = {
    "devfs",   "fdescfs", "procfs", "linprocfs", "linsysfs",
    "tmpfs",   "nullfs",  "unionfs", "fdesc",    "pseudofs"};

static int gem_os_should_expose_statfs(const struct statfs *sfs)
{
    size_t i;

    if (sfs == NULL) {
        return 0;
    }
    if (strcmp(sfs->f_mntonname, "/") == 0) {
        return 1;
    }
    for (i = 0;
         i < sizeof(gem_os_ignored_fstypes) / sizeof(gem_os_ignored_fstypes[0]);
         ++i) {
        if (strcmp(sfs->f_fstypename, gem_os_ignored_fstypes[i]) == 0) {
            return 0;
        }
    }
    return 1;
}

#else

static int gem_os_should_expose_mount(const struct mntent *mnt)
{
    static const char *const ignored_fs[] = {
        "proc",   "sysfs",   "tmpfs",    "devtmpfs",    "devpts",
        "cgroup", "cgroup2", "overlay",  "squashfs",    "nsfs",
        "mqueue", "debugfs", "tracefs",  "securityfs",  "pstore",
        "autofs", "fusectl", "configfs", "binfmt_misc", "ramfs"};
    size_t i;

    if (mnt == NULL || mnt->mnt_dir == NULL || mnt->mnt_type == NULL) {
        return 0;
    }
    if (strcmp(mnt->mnt_dir, "/") == 0) {
        return 1;
    }
    if (strncmp(mnt->mnt_dir, "/snap/", 6) == 0 ||
        strncmp(mnt->mnt_dir, "/proc", 5) == 0 ||
        strncmp(mnt->mnt_dir, "/sys", 4) == 0 ||
        strncmp(mnt->mnt_dir, "/dev", 4) == 0 ||
        (strncmp(mnt->mnt_dir, "/run", 4) == 0 &&
         strncmp(mnt->mnt_dir, "/run/media/", 11) != 0)) {
        return 0;
    }
    for (i = 0; i < sizeof(ignored_fs) / sizeof(ignored_fs[0]); ++i) {
        if (strcmp(mnt->mnt_type, ignored_fs[i]) == 0) {
            return 0;
        }
    }
    return 1;
}

#endif

static void gem_os_capitalize_label(char *label, size_t size)
{
    size_t i;
    int new_word = 1;

    if (label == NULL || size == 0u) {
        return;
    }

    for (i = 0; i < size && label[i] != '\0'; ++i) {
        if (label[i] == ' ' || label[i] == '_' || label[i] == '-') {
            new_word = 1;
            continue;
        }
        if (new_word != 0 && label[i] >= 'a' && label[i] <= 'z') {
            label[i] = (char)(label[i] - ('a' - 'A'));
        } else if (new_word == 0 && label[i] >= 'A' && label[i] <= 'Z') {
            label[i] = (char)(label[i] + ('a' - 'A'));
        }
        new_word = 0;
    }
}

#if defined(__FreeBSD__)

struct gem_os_volume_scan {
    struct statfs *entries;
    int count;
    int index;
};

int gem_os_volume_iter_open(gem_os_volume_iter_t *iter)
{
    struct gem_os_volume_scan *scan;
    int count;

    if (iter == NULL) {
        errno = EINVAL;
        return 0;
    }

    count = getfsstat(NULL, 0, MNT_NOWAIT);
    if (count < 0) {
        return 0;
    }

    scan = malloc(sizeof(*scan));
    if (scan == NULL) {
        return 0;
    }
    scan->entries = calloc((size_t)count, sizeof(struct statfs));
    if (scan->entries == NULL) {
        free(scan);
        return 0;
    }

    count = getfsstat(scan->entries,
                       (long)((size_t)count * sizeof(struct statfs)),
                       MNT_NOWAIT);
    if (count < 0) {
        free(scan->entries);
        free(scan);
        return 0;
    }

    scan->count = count;
    scan->index = 0;
    iter->handle = scan;
    return 1;
}

int gem_os_volume_iter_read(gem_os_volume_iter_t *iter, gem_os_volume_t *volume)
{
    struct gem_os_volume_scan *scan;
    const char *base;

    if (iter == NULL || volume == NULL || iter->handle == NULL) {
        errno = EINVAL;
        return 0;
    }

    scan = (struct gem_os_volume_scan *)iter->handle;
    while (scan->index < scan->count) {
        const struct statfs *sfs = &scan->entries[scan->index];

        scan->index++;
        if (!gem_os_should_expose_statfs(sfs)) {
            continue;
        }

        strncpy(volume->mount_path, sfs->f_mntonname,
                sizeof(volume->mount_path) - 1u);
        volume->mount_path[sizeof(volume->mount_path) - 1u] = '\0';

        if (strcmp(sfs->f_mntonname, "/") == 0) {
            strncpy(volume->label, "Root", sizeof(volume->label) - 1u);
            volume->label[sizeof(volume->label) - 1u] = '\0';
        } else {
            base = strrchr(sfs->f_mntonname, '/');
            if (base != NULL && base[1] != '\0') {
                ++base;
            } else {
                base = sfs->f_mntonname;
            }
            strncpy(volume->label, base, sizeof(volume->label) - 1u);
            volume->label[sizeof(volume->label) - 1u] = '\0';
            gem_os_capitalize_label(volume->label, sizeof(volume->label));
        }
        return 1;
    }
    return 0;
}

void gem_os_volume_iter_close(gem_os_volume_iter_t *iter)
{
    struct gem_os_volume_scan *scan;

    if (iter == NULL || iter->handle == NULL) {
        return;
    }
    scan = (struct gem_os_volume_scan *)iter->handle;
    free(scan->entries);
    free(scan);
    iter->handle = NULL;
}

#else

int gem_os_volume_iter_open(gem_os_volume_iter_t *iter)
{
    FILE *fp;

    if (iter == NULL) {
        errno = EINVAL;
        return 0;
    }

    fp = setmntent("/proc/mounts", "r");
    if (fp == NULL) {
        return 0;
    }

    iter->handle = fp;
    return 1;
}

int gem_os_volume_iter_read(gem_os_volume_iter_t *iter, gem_os_volume_t *volume)
{
    FILE *fp;
    struct mntent *mnt;
    const char *base;

    if (iter == NULL || volume == NULL || iter->handle == NULL) {
        errno = EINVAL;
        return 0;
    }

    fp = (FILE *)iter->handle;
    for (;;) {
        mnt = getmntent(fp);
        if (mnt == NULL) {
            return 0;
        }
        if (!gem_os_should_expose_mount(mnt)) {
            continue;
        }

        strncpy(volume->mount_path, mnt->mnt_dir,
                sizeof(volume->mount_path) - 1u);
        volume->mount_path[sizeof(volume->mount_path) - 1u] = '\0';

        if (strcmp(mnt->mnt_dir, "/") == 0) {
            strncpy(volume->label, "Root", sizeof(volume->label) - 1u);
            volume->label[sizeof(volume->label) - 1u] = '\0';
        } else {
            base = strrchr(mnt->mnt_dir, '/');
            if (base != NULL && base[1] != '\0') {
                ++base;
            } else {
                base = mnt->mnt_dir;
            }
            strncpy(volume->label, base, sizeof(volume->label) - 1u);
            volume->label[sizeof(volume->label) - 1u] = '\0';
            gem_os_capitalize_label(volume->label, sizeof(volume->label));
        }
        return 1;
    }
}

void gem_os_volume_iter_close(gem_os_volume_iter_t *iter)
{
    if (iter == NULL || iter->handle == NULL) {
        return;
    }

    (void)endmntent((FILE *)iter->handle);
    iter->handle = NULL;
}

#endif
